---
import { Picture } from "astro:assets";
import photo from "../assets/photo.jpg";
import {
  GITHUB,
  LINKEDIN,
  certificationCount,
  certifications,
  education,
  experience,
  otherProjects,
  person,
  projects,
  skills,
  type Lang,
} from "../data/profile";
import { t } from "../i18n/ui";
import Header from "./Header.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<Header lang={lang} />

<main id="contenido">
  <section class="hero">
    <div class="container hero-grid">
      <div class="photo-wrap">
        <Picture
          src={photo}
          alt={person.photoAlt[lang]}
          widths={[176, 352]}
          sizes="176px"
          formats={["avif", "webp"]}
          loading="eager"
          fetchpriority="high"
          class="photo"
        />
      </div>
      <div class="hero-text">
        <p class="eyebrow">{person.location[lang]}</p>
        <h1>{person.name}</h1>
        <p class="role">{person.role[lang]}</p>
        <p class="lead">{person.lead[lang]}</p>
        <div class="actions">
          <a class="button primary" href="#proyectos">{s.heroCta}</a>
          <a class="button" href={LINKEDIN}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm7 0h3.8v1.5h.06c.53-1 1.83-1.75 3.44-1.75 3.68 0 4.2 2.2 4.2 5.06v6.19h-4v-5.48c0-1.31-.02-2.98-1.82-2.98-1.82 0-2.1 1.42-2.1 2.89v5.57H10v-11Z"></path></svg>
            LinkedIn
          </a>
          <a class="button" href={GITHUB}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.8c-2.93.64-3.55-1.24-3.55-1.24-.48-1.22-1.17-1.54-1.17-1.54-.96-.66.07-.64.07-.64 1.06.07 1.62 1.09 1.62 1.09.94 1.61 2.47 1.15 3.07.88.1-.68.37-1.15.67-1.41-2.34-.27-4.8-1.17-4.8-5.2 0-1.15.41-2.09 1.08-2.83-.11-.27-.47-1.34.1-2.79 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.89-1.08 2.89-1.08.57 1.45.21 2.52.1 2.79.67.74 1.08 1.68 1.08 2.83 0 4.04-2.47 4.93-4.81 5.19.38.33.71.97.71 1.96v2.9c0 .28.19.61.73.5A10.5 10.5 0 0 0 12 1.5Z"></path></svg>
            GitHub
          </a>
        </div>
        <dl class="stats">
          <div>
            <dt>{s.stats.projects}</dt>
            <dd>{projects.length}</dd>
          </div>
          <div>
            <dt>{s.stats.certifications}</dt>
            <dd>{certificationCount}</dd>
          </div>
          <div>
            <dt>{s.stats.availability}</dt>
            <dd>{s.availabilityValue}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="proyectos" aria-labelledby="proyectos-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">01</p>
        <h2 id="proyectos-title">{s.projectsTitle}</h2>
        <p>{s.projectsIntro}</p>
      </div>
      <ul class="project-grid">
        {
          projects.map((project) => (
            <li class="card">
              <Picture
                src={project.image}
                alt={project.imageAlt[lang]}
                widths={[400, 800]}
                sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 46vw, 100vw"
                formats={["avif", "webp"]}
                class="shot"
              />
              <div class="card-body">
                <h3>{project.name}</h3>
                <p class="tagline">{project.tagline[lang]}</p>
                <p>{project.description[lang]}</p>
                <ul class="chips" aria-label="Stack">
                  {project.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="links">
                  <a href={project.repo}>
                    {s.code}
                    <span class="visually-hidden">: {project.name}</span>
                  </a>
                  {project.demo && (
                    <a href={project.demo}>
                      {s.demo}
                      <span class="visually-hidden">: {project.name}</span>
                    </a>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="subhead">{s.otherProjects}</h3>
      <ul class="others">
        {
          otherProjects.map((item) => (
            <li>
              <a href={item.repo}>{item.name}</a>
              <span>{item.description[lang]}</span>
              <span class="muted">{item.stack}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="experiencia" aria-labelledby="experiencia-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">02</p>
        <h2 id="experiencia-title">{s.experienceTitle}</h2>
      </div>
      <ol class="timeline">
        {
          experience.map((item) => (
            <li>
              <p class="period">{item.period[lang]}</p>
              <h3>{item.role[lang]}</h3>
              <p class="org">
                {item.link ? <a href={item.link}>{item.organization}</a> : item.organization}
                {item.organizationDetail && <span class="muted"> · {item.organizationDetail[lang]}</span>}
              </p>
              <ul>
                {item.points[lang].map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
        <li>
          <p class="period">{s.education}</p>
          <h3>{education.degree[lang]}</h3>
          <p class="org">
            {education.school}
            <span class="muted"> · {education.detail[lang]}</span>
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="habilidades" aria-labelledby="habilidades-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">03</p>
        <h2 id="habilidades-title">{s.skillsTitle}</h2>
        <p>{person.languages[lang]}</p>
      </div>
      <div class="skill-grid">
        {
          skills.map((group) => (
            <div class="skill-group">
              <h3>{group.name[lang]}</h3>
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="certificaciones" aria-labelledby="certificaciones-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">04</p>
        <h2 id="certificaciones-title">{s.certificationsTitle}</h2>
        <p>{s.certificationsIntro}</p>
      </div>
      <div class="cert-grid">
        {
          certifications.map((group, index) => (
            <details class="cert-group" open={index === 0}>
              <summary>
                <h3>{group.name[lang]}</h3>
                <span class="count">{group.items.length}</span>
              </summary>
              <ul>
                {group.items.map((cert) => (
                  <li>
                    {cert.url ? <a href={cert.url}>{cert.name}</a> : <span>{cert.name}</span>}
                    <span class="muted">
                      {" "}
                      · {cert.issuer} · {cert.year}
                    </span>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="contacto" aria-labelledby="contacto-title">
    <div class="container contact">
      <div>
        <p class="eyebrow">05</p>
        <h2 id="contacto-title">{s.contactTitle}</h2>
        <p>{s.contactText}</p>
        <p class="muted">{person.availability[lang]}</p>
      </div>
      <div class="actions">
        <a class="button primary" href={LINKEDIN}>{s.contactCta}</a>
        <a class="button" href={GITHUB}>GitHub</a>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container">
    <p>© {year} {person.name} · {s.footer}</p>
  </div>
</footer>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
    background:
      radial-gradient(60rem 30rem at 85% -10%, color-mix(in srgb, var(--primary) 14%, transparent), transparent 70%),
      radial-gradient(40rem 24rem at -10% 110%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }

  .photo-wrap {
    padding: 5px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1d4ed8, #0f766e);
    box-shadow: var(--shadow);
  }

  .photo-wrap :global(img) {
    width: 176px;
    height: 176px;
    border-radius: 50%;
    border: 4px solid var(--bg);
    object-fit: cover;
  }

  .hero-text {
    display: grid;
    gap: 0.85rem;
  }

  h1 {
    font-size: clamp(2rem, 1.3rem + 3vw, 3.4rem);
    letter-spacing: -0.02em;
  }

  .role {
    color: var(--primary);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 600;
  }

  .lead {
    max-width: 44rem;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 0.6rem 0 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dt {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .stats dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1.25rem;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .card :global(.shot) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }

  .card-body {
    display: grid;
    gap: 0.65rem;
    padding: 1.15rem 1.25rem 1.3rem;
    flex: 1;
    align-content: start;
  }

  .tagline {
    color: var(--accent);
    font-weight: 600;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.2rem;
    font-weight: 600;
  }

  .links a {
    display: inline-block;
    padding-block: 0.3rem;
  }

  .subhead {
    margin: 3rem 0 1rem;
    font-size: 1.3rem;
  }

  .others {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--border);
  }

  .others li {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr minmax(10rem, 18rem);
    gap: 0.4rem 1.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }

  .others a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .muted {
    color: var(--muted);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid var(--border);
    display: grid;
    gap: 2rem;
    max-width: 52rem;
  }

  .timeline > li {
    position: relative;
    display: grid;
    gap: 0.35rem;
  }

  .timeline > li::before {
    content: "";
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .period {
    color: var(--accent);
    font: 600 0.85rem/1.4 var(--mono);
  }

  .timeline ul {
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .skill-group {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .cert-grid {
    display: grid;
    gap: 0.9rem;
    max-width: 56rem;
  }

  .cert-group {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .cert-group summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.85rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .cert-group summary::-webkit-details-marker {
    display: none;
  }

  .cert-group summary::after {
    content: "+";
    margin-inline-start: auto;
    color: var(--muted);
    font: 600 1.2rem/1 var(--mono);
  }

  .cert-group[open] summary::after {
    content: "−";
  }

  .count {
    background: var(--chip);
    color: var(--chip-text);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .cert-group ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    padding: 0 1.25rem 1.15rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--border);
    background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 10%, var(--surface)), var(--surface));
  }

  .contact > div:first-child {
    display: grid;
    gap: 0.6rem;
    max-width: 38rem;
  }

  .footer {
    padding-block: 2rem 2.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 40rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .photo-wrap {
      justify-self: start;
    }

    .others li {
      grid-template-columns: 1fr;
    }
  }
</style>
